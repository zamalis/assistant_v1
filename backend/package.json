{
    "name": "tempo-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "module": "src/index.ts",
    "engines": {
        "bun": ">=1.3.0"
    },
    "scripts": {
        "dev": "bun --watch src/index.ts",
        "start": "bun src/index.ts",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "test": "bun test",
        "migration": "bun src/common/database/migration-cli.ts",
        "prepare": "cd .. && husky backend/.husky"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.5",
        "@types/bun": "^1.3.14",
        "@types/html-to-text": "^9.0.4",
        "@types/nodemailer": "^8.0.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.1.1",
        "pino-pretty": "^13.1.3",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@googleapis/calendar": "20.1.0",
        "@googleapis/gmail": "^22.0.2",
        "@hono/zod-validator": "^0.9.0",
        "@langchain/core": "^1.2.14",
        "@langchain/openai": "^1.6.2",
        "google-auth-library": "^11.3.2",
        "grammy": "^1.46.0",
        "handlebars": "^4.7.9",
        "hono": "^4.12.31",
        "html-to-text": "^10.0.0",
        "nodemailer": "^9.0.3",
        "pg": "^8.22.0",
        "pino": "^10.3.1",
        "reflect-metadata": "^0.2.2",
        "tsyringe": "^4.10.0",
        "typeorm": "^1.1.0",
        "typeorm-naming-strategies": "^4.1.0",
        "zod": "^4.4.3"
    }
}
