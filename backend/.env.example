# Application
NODE_ENV=development # development, production, or test
LOG_LEVEL=debug
PORT=4000

# CORS (comma-separated values, or * for defaults)
CORS_ORIGIN=
CORS_METHODS=
CORS_ALLOWED_HEADERS=

# Database (Postgres)
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# Email (SMTP)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Chat (openai is the only provider wired today)
OPENAI_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=

# OAuth (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL= # e.g. https://<your-ngrok-domain> — no trailing slash; Google redirect is <this>/oauth/google/callback

# Token encryption key (32 bytes)
TOKEN_ENCRYPTION_KEY=

